# Build context is quickeats-backend/; Dockerfiles need pkg/, services/ and the
# SQL that the Kubernetes init containers run (migrations and infra/seed).

# Secrets
.env
.env.*

# VCS, editors, OS
.git
.gitignore
.vscode
.idea
**/.DS_Store
**/Thumbs.db

# Not needed inside images
infra
!infra/seed
docker-compose*.yml
Makefile
**/*.md
**/*_test.go

# Build output
bin
dist
**/*.exe

# Stray folder from a failed mkdir (path too long to read)
{pkg*

# Deploy scripts run on the host, not in images
deploy
Jenkinsfile
